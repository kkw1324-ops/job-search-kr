{
  "description": "job-search-kr: 지원 서류 저장 가드(작성기록 확인, 초안은 job-writer만 저장)와 위임 작업자에게 읽을 절차 알리기.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/job-search-kr/scripts/doc_write_check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/job-search-kr/scripts/subagent_start.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
